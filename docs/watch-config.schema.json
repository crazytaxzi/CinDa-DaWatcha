{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crazytaxzi/CinDa-DaWatcha/blob/main/docs/watch-config.schema.json",
  "title": "CinDa-DaWatcha job ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["settings", "jobs"],
  "properties": {
    "settings": { "$ref": "#/$defs/settings" },
    "jobs": {
      "type": "array",
      "items": { "$ref": "#/$defs/job" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "absoluteWindowsPath": {
      "type": "string",
      "pattern": "^[A-Za-z]:\\\\"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pollIntervalMs",
        "heartbeatStaleMs",
        "conversationIdlePollMs",
        "conversationIdleStablePolls",
        "conversationIdleTimeoutMs",
        "sendVerificationTimeoutMs",
        "automaticSendAttempts",
        "firefoxBinary",
        "firefoxProfileDirectory",
        "geckoDriverPath",
        "deliveryStatePath"
      ],
      "properties": {
        "pollIntervalMs": { "type": "integer", "minimum": 250, "maximum": 60000 },
        "heartbeatStaleMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "conversationIdlePollMs": { "type": "integer", "minimum": 250, "maximum": 10000 },
        "conversationIdleStablePolls": { "type": "integer", "minimum": 2, "maximum": 30 },
        "conversationIdleTimeoutMs": { "type": "integer", "minimum": 10000, "maximum": 3600000 },
        "sendVerificationTimeoutMs": { "type": "integer", "minimum": 5000, "maximum": 300000 },
        "automaticSendAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "firefoxBinary": {
          "allOf": [
            { "$ref": "#/$defs/absoluteWindowsPath" },
            { "pattern": "(?i:firefox\\.exe)$" }
          ]
        },
        "firefoxProfileDirectory": { "$ref": "#/$defs/absoluteWindowsPath" },
        "geckoDriverPath": {
          "allOf": [
            { "$ref": "#/$defs/absoluteWindowsPath" },
            { "pattern": "(?i:geckodriver\\.exe)$" }
          ]
        },
        "deliveryStatePath": { "$ref": "#/$defs/absoluteWindowsPath" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "initiatingChatUuid",
        "createdAtUtc",
        "updatedAtUtc",
        "summary",
        "participants"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlank" },
        "enabled": { "type": "boolean" },
        "initiatingChatUuid": { "$ref": "#/$defs/uuid" },
        "recoveryChatUuid": {
          "oneOf": [
            { "$ref": "#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "createdAtUtc": { "$ref": "#/$defs/utc" },
        "updatedAtUtc": { "$ref": "#/$defs/utc" },
        "summary": { "type": "string" },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/participant" }
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "process",
        "state",
        "updatedAtUtc",
        "detail",
        "handoffMessage"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlank" },
        "process": { "$ref": "#/$defs/process" },
        "state": {
          "type": "string",
          "enum": ["Pending", "Running", "Blocked", "Succeeded", "Failed"]
        },
        "updatedAtUtc": { "$ref": "#/$defs/utc" },
        "heartbeatUtc": {
          "oneOf": [
            { "$ref": "#/$defs/utc" },
            { "type": "null" }
          ]
        },
        "finishedAtUtc": {
          "oneOf": [
            { "$ref": "#/$defs/utc" },
            { "type": "null" }
          ]
        },
        "exitCode": {
          "type": ["integer", "null"]
        },
        "detail": { "type": "string" },
        "handoffMessage": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "enum": ["Pending", "Running"] } } },
          "then": {
            "required": ["heartbeatUtc"],
            "properties": { "heartbeatUtc": { "$ref": "#/$defs/utc" } }
          }
        },
        {
          "if": { "properties": { "state": { "enum": ["Succeeded", "Failed"] } } },
          "then": {
            "required": ["finishedAtUtc"],
            "properties": {
              "finishedAtUtc": { "$ref": "#/$defs/utc" },
              "handoffMessage": { "$ref": "#/$defs/nonBlank" }
            }
          }
        }
      ]
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "name", "executablePath", "startTimeUtc"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "name": { "$ref": "#/$defs/nonBlank" },
        "executablePath": { "$ref": "#/$defs/absoluteWindowsPath" },
        "startTimeUtc": { "$ref": "#/$defs/utc" }
      }
    }
  }
}
